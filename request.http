### 1.1 — LOGIN USUARIO 1 (PROPIETARIO)
POST {{host}}/usuarios/login
Content-Type: application/json

{
  "email": "mariano@example.com",
  "password": "Password123"
}

### 1.2 — LOGIN USUARIO 2 (MIEMBRO)
POST {{host}}/usuarios/login
Content-Type: application/json

{
  "email": "ramiro@example.com",
  "password": "Password123"
}

#################################################################
## 🧩 PARTE 2 — GESTIÓN DE EQUIPOS
#################################################################

### 2.1 — CREAR EQUIPO (Propietario: Mariano)
POST {{host}}/equipos
Content-Type: application/json
Authorization: Bearer {{token_mariano}}

{
  "nombre": "Equipo Desarrollo IT"
}

### 2.2 — LISTAR EQUIPOS (Propietario autenticado)
GET {{host}}/equipos
Authorization: Bearer {{token_mariano}}

### 2.3 — AÑADIR MIEMBRO (Agregar a Ramiro al equipo ID 1)
POST {{host}}/equipos/1/members
Content-Type: application/json
Authorization: Bearer {{token_mariano}}

{
  "email": "ramiro@example.com",
  "rol": "Miembro"
}

### 2.4 — REMOVER MIEMBRO (Remover a Ramiro del equipo ID 1)
DELETE {{host}}/equipos/1/members
Content-Type: application/json
Authorization: Bearer {{token_mariano}}

{
  "email": "ramiro@example.com"
}

### 2.5 — ACTUALIZAR ROL DE MIEMBRO (Ejemplo: Ramiro pasa a Propietario)
PATCH {{host}}/equipos/1/role
Content-Type: application/json
Authorization: Bearer {{token_mariano}}

{
  "email": "ramiro@example.com",
  "nuevoRol": "Propietario"
}

### 2.6 — ELIMINAR EQUIPO (solo si no tiene tareas activas)
DELETE {{host}}/equipos/1
Authorization: Bearer {{token_mariano}}

#################################################################
## 🧩 PARTE 3 — TEST RÁPIDO DE VALIDACIONES
#################################################################

### 3.1 — CREAR EQUIPO SIN TOKEN (Debe fallar con 401)
POST {{host}}/equipos
Content-Type: application/json

{
  "nombre": "Equipo Sin Autenticación"
}

### 3.2 — CREAR EQUIPO REPETIDO (Debe fallar con 400)
POST {{host}}/equipos
Content-Type: application/json
Authorization: Bearer {{token_mariano}}

{
  "nombre": "Equipo Desarrollo IT"
}

### 3.3 — AÑADIR MIEMBRO INEXISTENTE (Debe fallar con 404)
POST {{host}}/equipos/1/members
Content-Type: application/json
Authorization: Bearer {{token_mariano}}

{
  "email": "noexiste@example.com",
  "rol": "Miembro"
}
