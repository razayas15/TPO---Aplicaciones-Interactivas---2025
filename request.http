@host = localhost
@baseUrl = http://{{host}}:3000/api

#################################################################
### 🟢 PARTE 0: CONFIGURACIÓN INICIAL
#################################################################

### 0.1 INICIAR EL SERVIDOR
# Asegúrate de correr en la terminal:
# npm run dev

### 0.2 LOGIN PARA OBTENER TOKEN
# Si los usuarios aún no existen, crealos con las peticiones 1.1 y 1.2.
POST {{baseUrl}}/usuarios/login
Content-Type: application/json

{
  "email": "ana@empresa.com",
  "password": "Password123"
}

@name auth_token
@prompt response.json "token"
# Copia el valor del token JWT retornado aquí para usarlo en las peticiones siguientes.


#################################################################
### 🧍‍♀️ PARTE 1: USUARIO, ROLES Y EQUIPOS (La Base)
#################################################################

### 1.1 REGISTRO DE USUARIO 1 (PROPIETARIO)
# ID: 1 | Email: ana@empresa.com
POST {{baseUrl}}/usuarios/signup
Content-Type: application/json

{
  "nombre": "Ana García",
  "email": "ana@empresa.com",
  "password": "Password123"
}

###

### 1.2 REGISTRO DE USUARIO 2 (MIEMBRO)
# ID: 2 | Email: juan@empresa.com
POST {{baseUrl}}/usuarios/signup
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "email": "juan@empresa.com",
  "password": "Password123"
}

###

### 1.3 CREAR EQUIPO (USUARIO 1 ES PROPIETARIO)
# ID: 1
POST {{baseUrl}}/equipos
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "nombre": "Equipo Desarrollo Backend"
}

###

### 1.4 AÑADIR MIEMBRO AL EQUIPO (INTEGRACIÓN DE NOTIFICACIÓN)
# Juan (ID 2) es añadido como Miembro.
POST {{baseUrl}}/equipos/1/members
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "email": "juan@empresa.com",
  "rol": "Miembro"
}


#################################################################
### 🧩 PARTE 2: GESTIÓN DE TAREAS Y AUDITORÍA
#################################################################

### 2.1 CREAR TAREA (ASIGNACIÓN -> DISPARA NOTIFICACIÓN)
# ID: 1 | Creador: Ana | Asignado: Juan
POST {{baseUrl}}/tareas
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "titulo": "Finalizar el Readme del TPI",
  "descripcion": "Asegurar que todos los comandos estén correctos.",
  "equipoId": 1,
  "prioridad": "Alta",
  "asignadoAId": 2,
  "fechaLimite": "2025-11-20T00:00:00Z"
}

###

### 2.2 CAMBIAR ESTADO DE LA TAREA (DISPARA ACTIVIDAD / NOTIFICACIÓN)
# Simula que Ana cambia el estado de 'PENDIENTE' a 'EN_CURSO'
PATCH {{baseUrl}}/tareas/1/estado
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "estado": "EN_CURSO"
}

###

### 2.3 AÑADIR COMENTARIO (Colaboración)
POST {{baseUrl}}/tareas/1/comentarios
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "contenido": "Confirmando que las pruebas de integración están funcionando correctamente."
}

###

### 2.4 VER HISTORIAL DE ACTIVIDAD (Auditoría)
# Muestra el historial de cambio de estado (Evento 2.2)
GET {{baseUrl}}/tareas/1/actividad
Authorization: Bearer {{auth_token}}

###

### 2.5 VER NOTIFICACIONES DEL USUARIO 2 (JUAN)
# Juan debería ver las notificaciones de ASIGNACIÓN (2.1) y CAMBIO_ESTADO (2.2)
# Nota: Para probar esto correctamente, logueate con el token de Juan.
GET {{baseUrl}}/notificaciones
Authorization: Bearer {{auth_token}}


#################################################################
### ⚙️ PARTE 3: REGLAS DE NEGOCIO Y LIMPIEZA
#################################################################

### 3.1 INTENTAR ELIMINAR EQUIPO CON TAREAS ACTIVAS
# Debe devolver 400 Bad Request (la tarea ID 1 está activa)
DELETE {{baseUrl}}/equipos/1
Authorization: Bearer {{auth_token}}

###

### 3.2 ELIMINAR TAREA ACTIVA
# Permite la eliminación del equipo después
DELETE {{baseUrl}}/tareas/1
Authorization: Bearer {{auth_token}}

###

### 3.3 ELIMINAR EQUIPO (FINAL)
# Ahora que el equipo no tiene tareas activas, la eliminación debe ser exitosa.
DELETE {{baseUrl}}/equipos/1
Authorization: Bearer {{auth_token}}
