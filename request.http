@host = http://localhost:4000/api

@name = token_ana
@prompt = response.json "token"

@name = token_juan
@prompt = response.json "token"

### 0.1 REGISTRAR USUARIO 1 (Propietario)
POST {{host}}/usuarios/signup
Content-Type: application/json

{
  "nombre": "Ana García",
  "email": "ana@gmail.com",
  "password": "Password123"
}

###
### 0.2 REGISTRAR USUARIO 2 (Miembro)
POST {{host}}/usuarios/signup
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "email": "juan@empresa.com",
  "password": "Password123"
}


### Login usuario
POST http://localhost:4000/api/usuarios/login
Content-Type: application/json

{
  "email": "ana@empresa.com",
  "password": "Password123"
}

### LISTADO DE USUARIOS
GET http://localhost:4000/api/usuarios
Accept: application/json

### Filtro por nombre (coincidencia parcial)
GET http://localhost:4000/api/usuarios?nombre=ramiro
Accept: application/json

###

### Filtro por email
GET http://localhost:4000/api/usuarios?email=@example.com
Accept: application/json

###

### Orden ascendente por fecha de creación
GET http://localhost:4000/api/usuarios?orden=dec
Accept: application/json

### Obtener usuario con ID 1
GET http://localhost:4000/api/usuarios/99
Content-Type: application/json

### =======================================
### 3. ACTUALIZAR USUARIO
### =======================================

# Actualizar nombre y contraseña del usuario con ID 1
PUT http://localhost:4000/api/usuarios/1
Content-Type: application/json

{
  "nombre": "Ana García (Editado)",
  "password": "NuevaPassword123"
}

###

# Actualizar solo el email
PUT http://localhost:4000/api/usuarios/1
Content-Type: application/json

{
  "email": "ana_actualizada@empresa.com"
}


### =======================================
### 4. ELIMINAR USUARIO
### =======================================

# Eliminar usuario con ID 1
DELETE http://localhost:4000/api/usuarios/1

###

# Intentar eliminar un usuario inexistente
DELETE http://localhost:4000/api/usuarios/999

###

# Intentar eliminar un usuario que pertenece a un equipo
# (Debe devolver error 400)
DELETE http://localhost:4000/api/usuarios/2

